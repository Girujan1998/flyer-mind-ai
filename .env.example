# Copy to .env.local for local overrides. Only EXPO_PUBLIC_* vars reach the app bundle.
# Never put secrets (API keys) here — those live on the server (see server/.env).

# The extraction API in server/. The iOS simulator can reach localhost; a
# physical device needs your machine's LAN IP, e.g. http://192.168.0.244:3001
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_AI_MODEL=claude-sonnet-5
