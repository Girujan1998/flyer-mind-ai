# Free Gemini API key — https://aistudio.google.com/apikey (no credit card).
# Copy this file to server/.env and set your real key. server/.env is gitignored.
# Use GEMINI_API_KEY=MOCK to return canned products without calling Gemini.
GEMINI_API_KEY=your_gemini_api_key_here

# Vision-capable Gemini model. Pinned so behaviour doesn't drift; swap for
# gemini-flash-latest to track Google's current flash tier.
GEMINI_MODEL=gemini-3.1-flash-lite

# Flyer pages per Gemini call. 1 = most reliable (full recall, tight boxes).
# 2-3 = fewer calls. Clamped to 1-4; above 3 the model drops products.
# PAGES_PER_REQUEST=1

# Port the API listens on (the app's EXPO_PUBLIC_API_BASE_URL must match).
PORT=3001
